# hermes-harness-clone · clone/.env
# Created by `python setup.py`. Never commit this file.

# Which harness runs the clone: antigravity (stable) | claude (experimental) | codex (experimental)
HARNESS=antigravity
# Optional: full path when the binary is not on PATH
# HARNESS_BIN=

# Your agent's name, as it calls itself in SOUL.md
AGENT_NAME=Hermes
# How the clone calls you in conversation excerpts
OWNER_NAME=the user

# Hermes location (auto-detected)
# HERMES_HOME=~/.hermes
# HERMES_BIN=

# Telegram: a NEW bot from @BotFather (one token = one poller; never reuse a token Hermes already uses)
TELEGRAM_TOKEN=
# Your numeric Telegram id (ask @userinfobot). Everyone else is ignored.
OWNER_ID=

# Hermes profiles the clone must never read, ask or schedule (comma separated)
PRIVATE_PROFILES=
# Where crons created by the clone deliver, e.g. telegram:123456789
CRON_DELIVER=origin

# Model (empty = harness default) and a fallback used on quota/rate errors
MODEL=
FALLBACK_MODEL=
# Hourly cap of harness turns from Telegram
MAX_TURNS_PER_HOUR=60
# Extra folders the harness may touch (comma separated)
EXTRA_DIRS=

# Optional voice notes: any OpenAI-compatible /v1/audio/transcriptions endpoint
WHISPER_URL=
WHISPER_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=

# Optional: messages matching this regex go to a Hermes profile instead of the harness
# (e.g. topics you only want on a local model)
SENSITIVE_REGEX=
SENSITIVE_PROFILE=

# Single-instance lock port
LOCK_PORT=9131
